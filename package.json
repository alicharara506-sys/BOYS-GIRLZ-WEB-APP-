{
  "name": "boys-and-girlz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/@react-router/dev/bin.js dev --host 127.0.0.1",
    "prebuild": "node scripts/generate-seo.mjs",
    "build": "npm run typecheck && node node_modules/@react-router/dev/bin.js build",
    "preview": "node node_modules/@react-router/serve/bin.js build/server/index.js",
    "typecheck": "node node_modules/@react-router/dev/bin.js typegen && node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "test": "node --test tests/store.test.mjs",
    "test:e2e": "node node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/quicksand": "^5.2.8",
    "@react-router/node": "^7.18.3",
    "@react-router/serve": "^7.18.3",
    "framer-motion": "^12.23.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "react-router-dom": "^7.18.3",
    "isbot": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@react-router/dev": "^7.18.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.0"
  }
