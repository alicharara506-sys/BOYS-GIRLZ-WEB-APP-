# TODO: Confirm these business details before launch. Never put private keys in VITE_ variables.
# The canonical production HTTPS origin only: no path, query, credentials or fragment.
# Confirmed by the owner; override only when changing the production domain.
VITE_PUBLIC_SITE_URL=https://boysandgirlz.com
# Keep false while the catalog is mock data. Enable only after every product is verified.
VITE_CATALOG_VERIFIED=false
VITE_SHOP_PHONE=
# Public shop WhatsApp number in international format, e.g. +961 followed by the confirmed number.
VITE_WHATSAPP_PHONE=+96181061731
VITE_SHOP_ADDRESS=
# Optional confirmed public business details. Do not invent missing facts.
VITE_SHOP_LOCALITY=
VITE_SHOP_POSTAL_CODE=
VITE_SHOP_COUNTRY_CODE=LB
VITE_SHOP_EMAIL=
VITE_SHOP_LATITUDE=
VITE_SHOP_LONGITUDE=
VITE_SHOP_FOUNDED=
# Schema.org openingHours format, for example Mo-Fr 09:00-17:00, only if confirmed.
VITE_SHOP_HOURS=
VITE_RETURNS_POLICY=
VITE_DELIVERY_ESTIMATE=
VITE_SHIPPING_FEE=5.95

# Optional public analytics / webmaster tokens. Blank values produce no tracking scripts.
# GA4 measurement ID has the format G-XXXXXXXXXX; never place API secrets here.
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# Server only. Use a Supabase direct or session-pooler (port 5432) connection.
# Never prefix secrets with VITE_ or commit a filled .env file.
DATABASE_URL=
DATABASE_SSL=true
SHIPPING_FEE_CENTS=
FREE_SHIPPING_THRESHOLD_CENTS=9900
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
ORDER_NOTIFICATION_EMAIL=
FORM_RATE_LIMIT_KEY=
